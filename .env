# Django / Backend
DJANGO_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,cinema_backend,0.0.0.0

# Database
POSTGRES_DB=cinema_booking
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Superuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# Frontend (CRA)
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_WS_URL=ws://localhost:8000
REACT_APP_USE_REAL_API=true

# Security
SECURE_SSL_REDIRECT=False

# Django settings module
DJANGO_SETTINGS_MODULE=cinemaBooking.settings